{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openxnet.local/agent/v1/audit-receipt.schema.json",
  "title": "OpenXnet Agent Audit Receipt",
  "description": "受控写工具返回的追加式审计回执。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receiptId",
    "requestId",
    "workspaceId",
    "incidentId",
    "traceId",
    "toolName",
    "actorId",
    "approverId",
    "approvalId",
    "requestDigest",
    "actionId",
    "actionStatus",
    "beforeResourceVersion",
    "afterResourceVersion",
    "startedAt",
    "completedAt",
    "evidenceIds"
  ],
  "properties": {
    "receiptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "incidentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "traceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "toolName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "approverId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "approvalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "actionStatus": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "beforeResourceVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "afterResourceVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceIds": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  }
}
