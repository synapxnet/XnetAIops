{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openxnet.local/agent/v1/tool-request.schema.json",
  "title": "OpenXnet Agent Tool Request",
  "description": "三平台 Agent 工具的统一请求包络。传输上下文由 HTTP 请求头提供。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "toolName",
    "arguments",
    "dryRun"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "toolName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,7}$",
      "maxLength": 160
    },
    "arguments": {
      "type": "object"
    },
    "approvalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "planDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stepId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "resourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "targetRevision": {
      "type": "integer",
      "minimum": 1
    },
    "expectedResourceVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "argumentsDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "compensation": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "dryRun": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "toolName": {
            "enum": [
              "aiops.gpu.capacity.ensure",
              "aiops.inference.runtime.tune",
              "aiops.inference.capacity.apply",
              "aiops.inference.traffic.shift",
              "aiops.inference.autoscaling.policy.update",
              "aiops.inference.capacity.converge",
              "dataops.training.dataset.build",
              "dataops.feature.backfill.start",
              "mlops.model.iteration.start",
              "mlops.feature.pipeline.publish",
              "mlops.training.search.start",
              "mlops.model.register",
              "mlops.feature.fallback.apply",
              "mlops.feature.fallback.remove",
              "mlops.deployment.canary.apply",
              "mlops.deployment.promote",
              "mlops.deployment.rollback"
            ]
          }
        },
        "required": [
          "toolName"
        ]
      },
      "then": {
        "required": [
          "approvalId",
          "planId",
          "planDigest",
          "stepId",
          "resourceId",
          "targetRevision",
          "expectedResourceVersion",
          "argumentsDigest",
          "compensation",
          "reason",
          "idempotencyKey"
        ]
      }
    }
  ]
}
