# ========================================
# XnetAIops Docker 部署环境变量配置
# 使用方法: 复制此文件为 .env，修改对应的值
#   cp .env.example .env
# ========================================

# 镜像标签
TAG=1.3.0

# 前端构建产物路径（相对于 docker-compose.yml）
WEB_DIST_PATH=../XnetAIops-web/apps/web-antd/dist
WEB_PORT=81

# ========== 数据库 ==========
DB_HOST=localhost
DB_PORT=3306
DB_PASSWORD=

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379

# ========== 服务端口映射（宿主机端口） ==========
CLM_PORT=9181
HOM_PORT=9182
SVM_PORT=9183
MON_PORT=9184
USR_PORT=9185
K8S_PORT=9186

# ========== 运行保障只读证据（AIOps Operations Workspace） ==========
# 三个领域服务共用现有 USR 组织成员校验；返回 HTTP 204 才允许读取。
# 生产环境必须由部署平台显式填写授权范围，默认 [] 保持拒绝访问。
OPERATIONS_ORGANIZATION_ACCESS_URL=http://aiops-usr-service:9185/api/usr/organization-access
OPERATIONS_RESOURCE_SCOPES=[]
OPERATIONS_DATABASE_TIME_ZONE=

# 终端连接需独立显式授权；默认未启用。Terminal access requires explicit grants; disabled by default.
K8S_ENCRYPTION_KEY=
TERMINAL_ORGANIZATION_ACCESS_URL=
TERMINAL_IDENTITY_URL=
TERMINAL_ALLOWED_ORIGINS=
TERMINAL_EXECUTION_GRANTS=[]
