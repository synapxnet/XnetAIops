# ========================================
# XnetAIops Docker 部署环境变量配置
# 使用方法: 复制此文件为 .env，修改对应的值
#   cp .env.example .env
# ========================================

# 镜像标签
TAG=latest

# 前端构建产物路径（相对于 docker-compose.yml）
WEB_DIST_PATH=../XnetAIops-web/playground/dist
WEB_PORT=81

# ========== 数据库 ==========
DB_HOST=localhost
DB_PORT=3306
DB_PASSWORD=

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379

# ========== 安全配置 ==========
JWT_SECRET=

# ========== 服务端口映射（宿主机端口） ==========
CLM_PORT=9181
HOM_PORT=9182
SVM_PORT=9183
MON_PORT=9184
USR_PORT=9185
K8S_PORT=9186
